<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS recommandé. Le HTTP reste permis pour un serveur sur le réseau local (ex. http://192.168.1.20:3000). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
