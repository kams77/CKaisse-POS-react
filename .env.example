# Variables du serveur KolaPass (à définir dans l'environnement ou docker-compose.yml)
# Code demandé une seule fois, pour créer le compte administrateur.
SETUP_CODE="choisissez-un-code-secret"
# Port HTTP
PORT=3000
# Dossier du fichier de données et des sauvegardes quotidiennes
DATA_DIR=./data
# "true" si le site est servi en HTTPS (proxy inversé)
COOKIE_SECURE=false
